# {name}.properties — DRAFT EXAMPLE (values shown = `balanced` profile defaults)
# The app reads/writes this file; plain-text editing works too. Every optimisation has its own key.
# Risk classes: R0 identical | R1 tiny risk | R2 small deviations | R3 big deviations.

# ---------- Profile ----------
parity-profile=balanced            # vanilla | balanced | performance | super-speed | custom
super-speed-confirm=false          # must be true to use parity-profile=super-speed

# ---------- Hardware (written by the app's hardware menu) ----------
hardware.ram-mb=auto
hardware.cpu-threads=auto
hardware.upload-mbps=auto          # home hosting: used for the capacity estimate
hardware.expected-max-players=auto
hardware.gc=auto                   # auto | zgc | g1 | shenandoah
threading.mode=auto                # auto | offload | regionised (experimental, later)
threading.worker-threads=auto

# ---------- World ----------
world.format=fast                  # fast | vanilla   (lossless converter included)
worldgen.parity=exact              # always exact (hard invariant; kept as a read-only safety key)

# ---------- Network / bandwidth (R0 unless noted) ----------
opt.chunk.packet-cache=true
opt.net.packet-batching=true
opt.net.offthread-encode=true
opt.tracker.spatial-index=true
opt.chunk.send-rate-limit=auto

# ---------- Tick tails / IO (R0) ----------
opt.io.async=true
opt.io.batched-writes=true
opt.autosave.spread=true

# ---------- Entities / blocks ----------
opt.hopper.event-driven=true            # R1
opt.item-merge.radius=vanilla           # R1  vanilla | larger
opt.redstone.algorithm=fast             # R1/R2  vanilla | fast
opt.mob.cramming=vanilla                # R1/R2  vanilla | optimised | simplified
opt.mob.activation-ranges=conservative  # R2  off | conservative | on | aggressive
opt.mob.ai-throttle=off                 # R2  off | on | aggressive
opt.view-distance.dynamic=true          # R2  only when overloaded
opt.light.deferred=false                # R2
opt.random-tick.budget=false            # R3
opt.entity.far-tick-skip=false          # R3
opt.physics.simplified=false            # R3

# ---------- Custom content ----------
content.virtual-entities.packet-only=true    # R0 core design
content.virtual-entities.max-per-player=auto
content.virtual-entities.view-range-scale=1.0
content.block.ticking.max-per-tick=auto
content.client-fallback=vanilla-lookalike    # vanilla-lookalike | kick
content.unknown-blocks=preserve              # preserve | placeholder

# ---------- FlowTail menu (pause-screen button + Custom Items) ----------
# All menu.* keys need a server restart: the pause-screen button is a data-driven dialog fixed at startup.
menu.enabled=true                          # false removes the button, the menu and /flowtail
menu.label=FlowTail                        # button + menu title, max 32 characters, no '#'
menu.color.from=8A2BE2                     # gradient start, RRGGBB without '#'  (purple)
menu.color.to=E040FB                       # gradient end,   RRGGBB without '#'  (purple-pink)
menu.bold=true
menu.custom-items.label=Custom Items       # button inside the FlowTail menu
menu.custom-items.title=Custom Items       # title of the chest menu
menu.custom-items.access=creative          # creative | op | everyone

# ---------- Resource pack ----------
pack.host.enabled=true
pack.host.port=8080
pack.host.public-url=auto
pack.required=true
pack.decline-action=kick                    # kick | limbo-lag
pack.per-world=true
pack.merge=build                    # auto | build | manual   (pending Q5)
pack.enforce.verification-probe=false   # opt-in, privacy implications (pending Q15)

# ---------- Bedrock / Geyser (Phase 7) ----------
bedrock.enabled=false
bedrock.manage-geyser=true
bedrock.floodgate=true
bedrock.auto-publish=true

# ---------- Logging / console ----------
log.structured=true
log.console.default-filter=all      # all | errors | warnings | errors+warnings
log.profiler.per-plugin=true
